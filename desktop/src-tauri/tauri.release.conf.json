{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "copyright": "Copyright © VisionGuard contributors",
    "shortDescription": "本地优先的多模态出版内容智能审校工具",
    "longDescription": "VisionGuard 在本机运行目标检测、OCR、文本基线与可选视觉语言模型，输出结构化出版内容审核结果。",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../runtime-dist-core/visionguard-core-runtime": "components/core-runtime",
      "../../models/core-models-v1": "components/core-models"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "compression": "lzma",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "startMenuFolder": "VisionGuard"
      }
    }
  }
}
